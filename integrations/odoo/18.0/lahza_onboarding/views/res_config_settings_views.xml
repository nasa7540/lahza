<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_lahza" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lahza</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Lahza" name="lahza_setting_container">
                    <setting string="Lahza link" help="The address of the Lahza app">
                        <field name="lahza_url"/>
                    </setting>
                    <setting string="Company code" help="Your company's Lahza invite code (the ?c= part of the link)">
                        <field name="lahza_company_code"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
