<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_lahza" model="ir.ui.view">
        <field name="name">hr.employee.form.lahza</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_lahza" type="object" class="oe_stat_button" icon="fa-compass" string="Open Lahza"/>
            </xpath>
        </field>
    </record>
</odoo>
